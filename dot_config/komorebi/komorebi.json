{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.37/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "mouse_follows_focus": false,
  "transparency": true,
  "transparency_alpha": 245,
  "default_workspace_padding": 6,
  "default_container_padding": 2,
  "border": true,
  "border_width": 3,
  "border_offset": -1,
  "border_style": "System",
  "theme": {
    "palette": "Base16",
    "name": "CatppuccinMocha",
    "unfocused_border": "Base01",
    "single_border": "Base07",
    "floating_border": "Base07"
  }
}
