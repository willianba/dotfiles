{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin",
  "autoupdate": true,
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "."
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "deno",
        "run",
        "--allow-net",
        "npm:@modelcontextprotocol/server-github"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_TOKEN"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "deno",
        "run",
        "--allow-env",
        "npm:@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "deno",
        "run",
        "--allow-env",
        "npm:@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    }
  }
}
